#!/bin/sh
# mn - mnemonic CLI: persistent, token-cheap memory for coding agents.
# POSIX sh. Requires: git, awk, sed, grep. Optional: curl or wget (update).
set -eu

MN_VERSION="0.4.0"
MN_URL="${MN_URL:-https://<own-domain>}"
MN_MAX_TOKENS="${MN_MAX_TOKENS:-1500}"
BEGIN_MARK="<!-- mnemonic:begin -->"
END_MARK="<!-- mnemonic:end -->"

die() { printf 'mn: %s\n' "$*" >&2; exit 2; }

root_dir() {
  if [ -n "${MN_DIR:-}" ]; then printf '%s\n' "$MN_DIR"; return; fi
  git rev-parse --show-toplevel 2>/dev/null || pwd
}

usage() {
  cat <<'EOF'
mn - persistent memory for coding agents

Usage:
  mn init [options]        Install or update the system in the current repo
  mn check                 Validate STATE.md and memory (size, caps, staleness)
  mn mem list              Print the long-term memory index
  mn mem find <words>      Search the index (does not open topic files)
  mn mem show <topic>      Print one topic file
  mn mem add <topic> "<keywords>" "<summary>"
                           Create a topic file and its index line
  mn sub link <name> <self|owner/repo[#folder]|url> ["description"]
                           Link a shared memory (submonic); creates it if missing.
                           "self" keeps it in this repo under shared/<name>
  mn sub list | sync [name] | unlink <name>
  mn sub find <words>      Search the indexes of all linked submonics
  mn sub show <name>/<topic>
  mn sub add <name> <topic> "<keywords>" "<summary>"
                           Create a shared topic (commit + push)
  mn sub path <name>       Local folder of a submonic, to edit topic files
  mn sub save <name> ["message"]
                           Commit and push edits (rebases on concurrent writes)
  mn archive <topic>       Move a memory topic out of the index (kept in git)
  mn status                Summary: preferences, state, memory, shared, automation
  mn hook start|stop       Agent session hooks (installed by init)
  mn update                Replace .mnemonic/mn with the latest published version
  mn version | help

init options (defaults in brackets):
  --chat-lang <lang>       Language used to talk to the user [en]
  --work-lang <lang>       Language for files, code, commits, docs [en]
  --commits <mode>         grouped | atomic | manual [grouped]
  --brand-refs <mode>      none | allowed [none]
  --code <mode>            on-request | proactive [on-request]
  --priority <mode>        savings | balanced | quality [savings]
  --docs <mode>            full | minimal | none [full]
  --tone <mode>            direct-humor | direct | formal [direct-humor]
  --agents <list>          Comma list of adapters to create: claude [claude]
  --dir <path>             Target repo root [git toplevel or cwd]

Environment: MN_MAX_TOKENS (STATE.md budget, default 1500), MN_STALE_DAYS (90), MN_URL,
MN_SKIP=1 (bypass the pre-commit hook once).
EOF
}

# ---------- preference text ----------

pref_lines() {
  printf -- '- chat_lang: %s\n' "$P_CHAT"
  printf -- '- work_lang: %s (files, code, commits, docs)\n' "$P_WORK"
  case "$P_COMMITS" in
    grouped) echo "- commits: one per major change, minor changes grouped, simple messages" ;;
    atomic)  echo "- commits: one per logical change, simple messages" ;;
    manual)  echo "- commits: only when the user asks" ;;
    *) die "invalid --commits: $P_COMMITS" ;;
  esac
  case "$P_BRAND" in
    none)    echo "- brand_refs: no AI tool or vendor names in git history, code or docs (required adapter filenames excepted); no co-author trailers" ;;
    allowed) echo "- brand_refs: allowed" ;;
    *) die "invalid --brand-refs: $P_BRAND" ;;
  esac
  case "$P_CODE" in
    on-request) echo "- code: write or change code only when the user asks; otherwise discuss and design" ;;
    proactive)  echo "- code: implement directly when the intent is clear" ;;
    *) die "invalid --code: $P_CODE" ;;
  esac
  case "$P_PRIORITY" in
    savings)  echo "- priority: minimize tokens; read only what is needed, short answers, no re-exploration" ;;
    balanced) echo "- priority: balance token cost and thoroughness" ;;
    quality)  echo "- priority: thoroughness over token cost" ;;
    *) die "invalid --priority: $P_PRIORITY" ;;
  esac
  case "$P_DOCS" in
    full)    echo "- docs: document every mechanism; concise but complete" ;;
    minimal) echo "- docs: README-level usage only" ;;
    none)    echo "- docs: only when asked" ;;
    *) die "invalid --docs: $P_DOCS" ;;
  esac
  case "$P_TONE" in
    direct-humor) echo "- tone: direct, clear summaries, light humor welcome, say so when a question is trivial" ;;
    direct)       echo "- tone: direct, clear summaries, no filler" ;;
    formal)       echo "- tone: formal and neutral" ;;
    *) die "invalid --tone: $P_TONE" ;;
  esac
}

agents_block() {
  echo "$BEGIN_MARK"
  echo "## Preferences"
  pref_lines
  cat <<'EOF'

## Memory protocol
Files:
- STATE.md: live project state. Loaded every session. Budget ~1500 tokens.
- memory/INDEX.md + memory/<topic>.md: long-term memory. Never read it whole. When you need a fact that STATE.md does not have (or the user asks), run `.mnemonic/mn mem find <words>` and open only the matching topic, before answering "unknown" or re-exploring code.
- .mnemonic/mn: helper CLI (`.mnemonic/mn help`). Guide: .mnemonic/README.md.

Session start:
1. If STATE.md is not already in context, read it. Nothing else by default.
2. If it may be outdated, run `.mnemonic/mn check` (reports commits since the last STATE.md update).
3. Do not re-explore what STATE.md or a memory topic answers. Do not reopen recorded decisions without new facts.

Before the final commit of a task or session:
1. Rewrite STATE.md; never append. Drop finished items: git log is the history.
2. Caps (lines): Goal 3, Current 5, Next 7, Decisions 10, Blockers 5, Notes 5. Prune the least relevant.
3. Pruned but valuable knowledge: `.mnemonic/mn mem add <topic> "<keywords>" "<summary>"`, then write memory/<topic>.md.
4. Run `.mnemonic/mn check`, fix warnings, commit STATE.md together with the work.
Automation: the pre-commit hook rejects work commits without STATE.md or with check warnings; the turn-end hook asks for a STATE.md update after unreflected commits. Comply, do not bypass.

Deliverables you generate (reports, charts, PDFs, page sources) go in artifacts/<topic>/.

Style for STATE.md and memory: telegraphic, one line per item, `what -> why`, lists not tables, paths instead of descriptions, no emojis.
EOF
  shared_section
  echo "$END_MARK"
}

shared_section() {
  # Rendered only when .mnemonic/links has entries.
  [ -s .mnemonic/links ] || return 0
  grep -q '^[A-Za-z0-9._-]* *=' .mnemonic/links || return 0
  echo
  echo "## Shared memory"
  echo "Submonics shared with other sessions; every session may read and write. Search them when a needed fact is in neither STATE.md nor local memory."
  sed -n 's/^\([A-Za-z0-9._-]*\) *= *[^|]*|* *\(.*\)$/- \1: \2/p' .mnemonic/links | sed 's/: $//'
  cat <<'EOF'
- Find: `.mnemonic/mn sub find <words>`. Read: `.mnemonic/mn sub show <name>/<topic>`.
- New topic: `.mnemonic/mn sub add <name> <topic> "<keywords>" "<summary>"`, then edit the file at `.mnemonic/mn sub path <name>` and run `.mnemonic/mn sub save <name> "<message>"`.
- Write facts other sessions need (infrastructure, cross-repo decisions); never secrets, only where they are kept.
EOF
}

# ---------- templates ----------

state_template() {
  cat <<EOF
# STATE
updated: $(date +%Y-%m-%d)

## Goal
- (one to three lines: what this project is for)

## Current
- (work in progress and where it stands)

## Next
1. (next steps, in order)

## Decisions
- (decision -> reason)

## Blockers
- (open questions, failures to avoid)

## Notes
- (short facts worth keeping)
EOF
}

index_template() {
  cat <<'EOF'
# Memory index
Long-term memory. Read only when the user asks; then open only the matching topic.
Format: `- <topic>: <keywords> - <summary>` -> file memory/<topic>.md

EOF
}

artifacts_readme() {
  cat <<'EOF'
# artifacts
Generated deliverables: reports, charts, PDFs, page sources. One folder per
topic (`artifacts/<topic>/`). Not loaded into agent context; link them from
STATE.md or a memory topic when they matter. Keep secrets out.
EOF
}

guide_text() {
  cat <<'EOF'
# Memory system (mnemonic)

This repository keeps its working memory in git so that any session can resume
work by reading a few small files instead of re-exploring the code or replaying
old conversations.

## Files
| File | Loaded | Purpose |
|---|---|---|
| AGENTS.md | every session | Preferences and the memory protocol, between `mnemonic:begin/end` markers. Content outside the markers is yours. |
| CLAUDE.md | every session | Adapter for agents that do not read AGENTS.md natively. It only imports `@AGENTS.md` and `@STATE.md`, so both load at start without extra reads. |
| STATE.md | every session | Live state: Goal, Current, Next, Decisions, Blockers, Notes. Rewritten, never appended. Budget ~1500 tokens. |
| memory/INDEX.md | when needed | One line per long-term topic: name, keywords, summary. Searched automatically when STATE.md lacks a fact. |
| memory/<topic>.md | on demand | Long-term knowledge: architecture, old decisions, failed approaches, domain context. |
| shared/<name>/ | when needed | Shared memory kept in this repository (submonics linked as `self`). |
| artifacts/ | never | Generated deliverables: reports, charts, PDFs, page sources. |
| .mnemonic/mn | never (run) | Helper CLI. |

## How a session works
1. Start: AGENTS.md and STATE.md are already in context. The agent works from
   STATE.md and does not re-explore what it already answers.
2. Work: as usual. Recorded decisions are not reopened without new facts.
3. Close: the agent rewrites STATE.md (finished items removed, caps respected),
   moves valuable pruned knowledge to long-term memory, runs `mn check` and
   commits STATE.md with the work.

History lives in `git log`; STATE.md only describes the present and the next
steps, so its size, and its cost per session, stays constant.

## Using long-term memory
It is never loaded whole. When the agent needs a fact that STATE.md does not
have, it searches the index (`mn mem find`) and opens only the matching topic,
before answering "unknown" or re-exploring the code. You can also ask for it,
e.g. "check memory about authentication".

## Commands
```
.mnemonic/mn check                  validate size, caps, staleness, index
.mnemonic/mn mem list               show the index
.mnemonic/mn mem find <words>       search the index
.mnemonic/mn mem show <topic>       print one topic
.mnemonic/mn mem add <topic> "<keywords>" "<summary>"
.mnemonic/mn init [options]         re-run to change preferences
.mnemonic/mn update                 fetch the latest mn
```

## Shared memory (optional)
Submonics are shared memories. By default they live in this repository under
`shared/<name>/` (linked as `self`); other repositories link them as
`owner/this-repo#shared/<name>`. A separate hub repository is also possible. Every linked session can read and
write them; they are read only when needed. Linked submonics are listed in
`.mnemonic/links` and summarized in AGENTS.md.
```
.mnemonic/mn sub link infra self "servers, domains"      in this repo
.mnemonic/mn sub link infra owner/repo#shared/infra "…"  from another repo
.mnemonic/mn sub find <words>         search all linked indexes
.mnemonic/mn sub show infra/<topic>   read one topic
.mnemonic/mn sub add infra <topic> "<keywords>" "<summary>"
.mnemonic/mn sub save infra "<message>"   after editing in $(mn sub path infra)
```
Never store secrets in shared memory; only where they are kept.

## Automation
- Git pre-commit hook (`.mnemonic/hooks`, enabled through core.hooksPath):
  rejects commits that change work files without STATE.md, or that fail
  `mn check`. Bypass once with `MN_SKIP=1 git commit ...`.
- Agent hooks (`.claude/settings.json`): at session start they re-enable the
  git hook in fresh clones, sync shared memory and report problems; at the
  end of each turn they save shared memory edits and ask the agent to update
  STATE.md if commits were made without it.
- `mn check` flags memory topics not updated in 90 days; `mn archive <topic>`
  moves one out of the index (still in git).
- `mn status` prints a one-screen summary.

## Changing preferences
Edit the Preferences list in AGENTS.md, or re-run `mn init` with only the
options that change (`.mnemonic/mn help`); other choices are kept from
`.mnemonic/config`. Re-running only replaces the marked block; STATE.md and
memory are never overwritten.

## Uninstall
Delete `.mnemonic/`, `memory/`, `STATE.md`, the marked block in AGENTS.md,
the two import lines in CLAUDE.md and the `.mnemonic/cache/` line in
.gitignore. Shared memory repositories are not touched.
EOF
}

# ---------- init ----------

write_block() {
  # Insert or replace the marked block in $1 with the content of file $2.
  target=$1 block=$2
  if [ ! -f "$target" ]; then
    { echo "# AGENTS.md"; echo; cat "$block"; } > "$target"
    echo "created  $target"
  elif grep -qF "$BEGIN_MARK" "$target"; then
    awk -v b="$BEGIN_MARK" -v e="$END_MARK" -v f="$block" '
      $0==b { while ((getline l < f) > 0) print l; skip=1; next }
      $0==e { skip=0; next }
      !skip { print }' "$target" > "$target.tmp" && mv "$target.tmp" "$target"
    echo "updated  $target (marked block)"
  else
    { echo; cat "$block"; } >> "$target"
    echo "appended $target (marked block)"
  fi
}

ensure_line() {
  # Append line $2 to file $1 if missing.
  grep -qxF "$2" "$1" 2>/dev/null || printf '%s\n' "$2" >> "$1"
}

create_if_missing() {
  # create_if_missing <file> <generator function>
  if [ -e "$1" ]; then echo "kept     $1"; else "$2" > "$1"; echo "created  $1"; fi
}

load_config() {
  # Defaults, then values saved by a previous init in .mnemonic/config.
  P_CHAT=en P_WORK=en P_COMMITS=grouped P_BRAND=none P_CODE=on-request
  P_PRIORITY=savings P_DOCS=full P_TONE=direct-humor P_AGENTS=claude
  if [ ! -f "$1/.mnemonic/config" ]; then
    # Installs older than .mnemonic/config: recover languages from AGENTS.md.
    [ -f "$1/AGENTS.md" ] || return 0
    v=$(sed -n 's/^- chat_lang: //p' "$1/AGENTS.md" | head -1); [ -n "$v" ] && P_CHAT=$v
    v=$(sed -n 's/^- work_lang: \([^ ]*\).*/\1/p' "$1/AGENTS.md" | head -1); [ -n "$v" ] && P_WORK=$v
    return 0
  fi
  while IFS='=' read -r k v; do
    case "$k" in
      chat_lang) P_CHAT=$v ;; work_lang) P_WORK=$v ;; commits) P_COMMITS=$v ;;
      brand_refs) P_BRAND=$v ;; code) P_CODE=$v ;; priority) P_PRIORITY=$v ;;
      docs) P_DOCS=$v ;; tone) P_TONE=$v ;; agents) P_AGENTS=$v ;;
    esac
  done < "$1/.mnemonic/config"
}

save_config() {
  printf 'chat_lang=%s\nwork_lang=%s\ncommits=%s\nbrand_refs=%s\ncode=%s\npriority=%s\ndocs=%s\ntone=%s\nagents=%s\n' \
    "$P_CHAT" "$P_WORK" "$P_COMMITS" "$P_BRAND" "$P_CODE" "$P_PRIORITY" "$P_DOCS" "$P_TONE" "$P_AGENTS" > .mnemonic/config
}

render_agents() {
  # Re-render the AGENTS.md block from saved config (used after link changes).
  load_config .
  tmp=$(mktemp); agents_block > "$tmp"; write_block AGENTS.md "$tmp" >/dev/null; rm -f "$tmp"
}

cmd_init() {
  for a in "$@"; do [ "${prev:-}" = --dir ] && MN_DIR=$a; prev=$a; done
  load_config "$(root_dir)"
  while [ $# -gt 0 ]; do
    [ $# -ge 2 ] || die "missing value for $1"
    case "$1" in
      --chat-lang)  P_CHAT=$2 ;;
      --work-lang)  P_WORK=$2 ;;
      --commits)    P_COMMITS=$2 ;;
      --brand-refs) P_BRAND=$2 ;;
      --code)       P_CODE=$2 ;;
      --priority)   P_PRIORITY=$2 ;;
      --docs)       P_DOCS=$2 ;;
      --tone)       P_TONE=$2 ;;
      --agents)     P_AGENTS=$2 ;;
      --dir)        MN_DIR=$2 ;;
      *) die "unknown option: $1" ;;
    esac
    shift 2
  done
  d=$(root_dir); [ -d "$d" ] || die "no such directory: $d"
  self=$0
  cd "$d"

  tmp=$(mktemp); agents_block > "$tmp"   # validates options before writing
  mkdir -p .mnemonic memory
  write_block AGENTS.md "$tmp"; rm -f "$tmp"
  save_config; echo "wrote    .mnemonic/config"
  ensure_line .gitignore ".mnemonic/cache/"

  old_ifs=$IFS; IFS=,
  for a in $P_AGENTS; do
    case "$a" in
      claude)
        [ -f CLAUDE.md ] && s="updated " || s="created "
        ensure_line CLAUDE.md "@AGENTS.md"; ensure_line CLAUDE.md "@STATE.md"
        echo "$s CLAUDE.md"
        install_agent_hooks ;;
      "") ;;
      *) IFS=$old_ifs; die "unsupported agent: $a" ;;
    esac
  done
  IFS=$old_ifs

  create_if_missing STATE.md state_template
  create_if_missing memory/INDEX.md index_template
  mkdir -p artifacts; create_if_missing artifacts/README.md artifacts_readme
  guide_text > .mnemonic/README.md; echo "wrote    .mnemonic/README.md"

  if [ -f "$self" ] && [ "$(cd "$(dirname "$self")" && pwd)/$(basename "$self")" != "$(pwd)/.mnemonic/mn" ]; then
    cp "$self" .mnemonic/mn
  fi
  [ -f .mnemonic/mn ] && chmod +x .mnemonic/mn && echo "wrote    .mnemonic/mn"

  readme_note="## Memory system
This repository uses mnemonic, a git-based memory for coding agents. See [.mnemonic/README.md](.mnemonic/README.md)."
  if [ ! -f README.md ]; then
    printf '# %s\n\n%s\n' "$(basename "$(pwd)")" "$readme_note" > README.md
    echo "created  README.md"
  elif ! grep -qF ".mnemonic/README.md" README.md; then
    printf '\n%s\n' "$readme_note" >> README.md
    echo "appended README.md (memory section)"
  else
    echo "kept     README.md"
  fi
  install_hooks
  echo
  cmd_status
}

# ---------- check ----------

cmd_check() {
  cd "$(root_dir)"
  precommit=0; [ "${1:-}" = --pre-commit ] && precommit=1
  warn=0
  w() { printf 'WARN %s\n' "$*"; warn=$((warn + 1)); }
  [ -f STATE.md ] || { echo "FAIL STATE.md missing (run mn init)"; exit 1; }

  chars=$(wc -c < STATE.md | tr -d ' ')
  tokens=$((chars / 4))
  if [ "$tokens" -gt "$MN_MAX_TOKENS" ]; then w "STATE.md ~${tokens} tokens > ${MN_MAX_TOKENS}: prune"
  else echo "ok   STATE.md ~${tokens}/${MN_MAX_TOKENS} tokens"; fi

  caps=$(awk '
    BEGIN { cap["Goal"]=3; cap["Current"]=5; cap["Next"]=7; cap["Decisions"]=10; cap["Blockers"]=5; cap["Notes"]=5 }
    /^## / { sec=substr($0,4); next }
    sec!="" && /^[ \t]*([-*]|[0-9]+\.)[ \t]/ { n[sec]++ }
    END { for (s in cap) if (n[s] > cap[s]) printf "WARN section %s has %d items > %d\n", s, n[s], cap[s] }' STATE.md)
  if [ -n "$caps" ]; then
    printf '%s\n' "$caps"; warn=$((warn + $(printf '%s\n' "$caps" | wc -l)))
  else echo "ok   section caps"; fi
  for s in Goal Current Next Decisions Blockers Notes; do
    grep -q "^## $s\$" STATE.md || w "STATE.md missing section: $s"
  done

  if [ "$precommit" -eq 0 ] && git rev-parse --git-dir >/dev/null 2>&1; then
    last=$(git log -1 --format=%H -- STATE.md 2>/dev/null || true)
    if [ -z "$last" ]; then w "STATE.md never committed"
    else
      behind=$(git rev-list --count "$last..HEAD")
      if [ "$behind" -gt 0 ]; then w "STATE.md not updated in the last $behind commit(s): verify with git log --oneline -$behind"
      else echo "ok   STATE.md up to date with HEAD"; fi
    fi
    git diff --quiet HEAD -- STATE.md 2>/dev/null || echo "info STATE.md has uncommitted changes"
  fi

  if [ -f memory/INDEX.md ]; then
    topics=$(sed -n 's/^- \([A-Za-z0-9._-]*\):.*/\1/p' memory/INDEX.md)
    for t in $topics; do [ -f "memory/$t.md" ] || w "index entry without file: memory/$t.md"; done
    for f in memory/*.md; do
      [ -f "$f" ] || continue
      t=$(basename "$f" .md); [ "$t" = INDEX ] && continue
      printf '%s\n' "$topics" | grep -qxF "$t" || w "topic not in index: $f"
    done
    echo "ok   memory index checked ($(printf '%s' "$topics" | grep -c . || true) topics)"
    cutoff=$(date -d "-${MN_STALE_DAYS:-90} days" +%Y-%m-%d 2>/dev/null || date -v-"${MN_STALE_DAYS:-90}"d +%Y-%m-%d 2>/dev/null || true)
    if [ -n "$cutoff" ]; then
      for f in memory/*.md; do
        [ -f "$f" ] || continue; t=$(basename "$f" .md); [ "$t" = INDEX ] && continue
        u=$(sed -n 's/^updated: //p' "$f" | head -1)
        if [ -n "$u" ] && [ "$u" \< "$cutoff" ]; then echo "info topic $t not updated since $u: archive with mn archive $t"; fi
      done
    fi
  else
    w "memory/INDEX.md missing"
  fi

  [ "$warn" -eq 0 ] && echo "all checks passed" || { echo "$warn warning(s)"; exit 1; }
}

# ---------- memory ----------

cmd_mem() {
  cd "$(root_dir)"
  [ -f memory/INDEX.md ] || die "memory/INDEX.md missing (run mn init)"
  sub=${1:-list}; [ $# -gt 0 ] && shift
  case "$sub" in
    list) grep '^- ' memory/INDEX.md || echo "(no topics)" ;;
    find)
      [ $# -gt 0 ] || die "usage: mn mem find <words>"
      pat=$(printf '%s' "$*" | sed 's/[][\.*^$/]/\\&/g; s/  */|/g')
      grep -iE "^- .*($pat)" memory/INDEX.md || { echo "(no match)"; exit 1; } ;;
    show)
      [ $# -eq 1 ] || die "usage: mn mem show <topic>"
      [ -f "memory/$1.md" ] || die "no topic: $1"
      cat "memory/$1.md" ;;
    add)
      [ $# -eq 3 ] || die 'usage: mn mem add <topic> "<keywords>" "<summary>"'
      printf '%s' "$1" | grep -qE '^[A-Za-z0-9._-]+$' || die "topic must match [A-Za-z0-9._-]+"
      [ "$1" != INDEX ] || die "reserved name: INDEX"
      grep -q "^- $1:" memory/INDEX.md && die "topic exists: $1"
      printf -- '- %s: %s - %s\n' "$1" "$2" "$3" >> memory/INDEX.md
      [ -f "memory/$1.md" ] || printf '# %s\nkeywords: %s\nsummary: %s\nupdated: %s\n\n' "$1" "$2" "$3" "$(date +%Y-%m-%d)" > "memory/$1.md"
      echo "added memory/$1.md" ;;
    *) die "unknown mem command: $sub" ;;
  esac
}

# ---------- shared memory (submonics) ----------
# .mnemonic/links: "<name> = <repo>[#<folder>] | <description>"
#   <repo>: owner/name (GitHub) or any git URL/path. Cache: .mnemonic/cache/

link_spec() { sed -n "s/^$1 *= *\([^|]*\).*/\1/p" .mnemonic/links 2>/dev/null | sed 's/ *$//' | head -1; }
spec_url() {
  r=${1%%#*}
  if [ -d "$r" ]; then (cd "$r" && pwd)
  elif printf '%s' "$r" | grep -qE '^[A-Za-z0-9][A-Za-z0-9_.-]*/[A-Za-z0-9_.-]+$'; then echo "https://github.com/$r.git"
  else echo "$r"; fi
}
spec_folder() { case "$1" in *#*) echo "${1#*#}" ;; *) echo "" ;; esac; }
cache_of() { echo ".mnemonic/cache/$(printf '%s' "$1" | sed 's/[^A-Za-z0-9._-]/_/g')"; }
sub_names() { sed -n 's/^\([A-Za-z0-9._-]*\) *=.*/\1/p' .mnemonic/links 2>/dev/null; }

sub_resolve() {
  # sub_resolve <name>: sets S_SELF S_URL S_REPO (clone or ".") S_DIR (submonic dir)
  spec=$(link_spec "$1"); [ -n "$spec" ] || die "unknown submonic: $1 (see mn sub list)"
  f=$(spec_folder "$spec")
  case "$spec" in
    self|self\#*) S_SELF=1; S_URL=""; S_REPO=.; S_DIR=shared/${f:-$1} ;;
    *) S_SELF=0; S_URL=$(spec_url "$spec"); S_REPO=$(cache_of "$S_URL"); S_DIR=$S_REPO${f:+/$f} ;;
  esac
}

sub_sync() { [ "$S_SELF" = 1 ] || sync_repo "$S_URL" "$S_REPO"; }
sub_ready() { [ "$S_SELF" = 1 ] || [ -d "$S_REPO/.git" ]; }
sub_commit() {
  # sub_commit <message>: in-repo submonics commit only their folder (pushed with normal work);
  # external ones commit and push the cache clone.
  if [ "$S_SELF" = 1 ]; then
    git add -- "$S_DIR"
    if git diff --cached --quiet -- "$S_DIR"; then echo "nothing to save"; return 0; fi
    git commit -q -m "$1" -- "$S_DIR" && echo "saved: $1 (commit in this repo; pushed with your next push)"
  else
    rel=${S_DIR#"$S_REPO"}; rel=${rel#/}
    push_repo "$S_REPO" "$1" "${rel:-.}"
  fi
}

remote_has_commits() { git -C "$1" ls-remote --heads origin 2>/dev/null | grep -q .; }
pull_repo() { git -C "$1" pull -q --rebase origin "$(git -C "$1" symbolic-ref --short HEAD)" 2>/dev/null; }

sync_repo() {
  # sync_repo <url> <cache-dir>
  if [ ! -d "$2/.git" ]; then
    mkdir -p .mnemonic/cache
    git clone -q "$1" "$2" 2>/dev/null || die "cannot clone $1 (check access)"
    n=$(git config user.name || true); e=$(git config user.email || true)
    [ -n "$n" ] && git -C "$2" config user.name "$n"
    [ -n "$e" ] && git -C "$2" config user.email "$e"
    git -C "$2" rev-parse -q --verify HEAD >/dev/null || git -C "$2" symbolic-ref HEAD refs/heads/main
  elif remote_has_commits "$2"; then
    pull_repo "$2" || die "pull failed in $2: resolve manually"
  fi
  touch "$2/.git/mn-synced"
}

push_repo() {
  # push_repo <cache-dir> <message> [path]: commit and push, rebasing on conflicts.
  git -C "$1" add -A -- "${3:-.}"
  git -C "$1" diff --cached --quiet && { echo "nothing to save"; return 0; }
  git -C "$1" commit -qm "$2"
  i=0
  while [ $i -lt 3 ]; do
    git -C "$1" push -q -u origin HEAD 2>/dev/null && { echo "saved: $2"; return 0; }
    pull_repo "$1" || { git -C "$1" rebase --abort 2>/dev/null; die "conflict in $1: another session edited the same lines; resolve and run mn sub save"; }
    i=$((i + 1))
  done
  die "push failed after retries: $1"
}

ensure_submonic() {
  # Create the submonic folder with an index (and a hub README) if missing.
  [ -f "$S_DIR/INDEX.md" ] && return 0
  mkdir -p "$S_DIR"
  printf '# %s\nShared memory. Read only when needed; open only the matching topic.\nFormat: `- <topic>: <keywords> - <summary>` -> file <topic>.md\n\n' "$1" > "$S_DIR/INDEX.md"
  if [ "$S_SELF" = 0 ] && [ "$S_DIR" != "$S_REPO" ] && [ ! -f "$S_REPO/README.md" ]; then
    cat > "$S_REPO/README.md" <<'EOF'
# mnemonic hub
Shared memory for coding agent sessions. Each folder is a submonic: an
INDEX.md (one line per topic) plus one file per topic. Every linked session
may read and write; read on demand only. Never store secrets here, only where
they are kept. Managed with `mn sub` (see the mnemonic docs).
EOF
  fi
  if [ "$S_SELF" = 1 ]; then sub_commit "Create submonic $1"; else push_repo "$S_REPO" "Create submonic $1"; fi
}

cmd_sub() {
  cd "$(root_dir)"
  sub=${1:-list}; [ $# -gt 0 ] && shift
  case "$sub" in
    link)
      [ $# -ge 2 ] || die 'usage: mn sub link <name> <owner/repo[#folder]|url> ["description"]'
      printf '%s' "$1" | grep -qE '^[A-Za-z0-9._-]+$' || die "name must match [A-Za-z0-9._-]+"
      [ -z "$(link_spec "$1")" ] || die "already linked: $1"
      mkdir -p .mnemonic
      printf '%s = %s | %s\n' "$1" "$2" "${3:-}" >> .mnemonic/links
      sub_resolve "$1"; sub_sync; ensure_submonic "$1"
      render_agents; echo "linked $1 -> $2" ;;
    unlink)
      [ $# -eq 1 ] || die "usage: mn sub unlink <name>"
      [ -n "$(link_spec "$1")" ] || die "unknown submonic: $1"
      grep -v "^$1 *=" .mnemonic/links > .mnemonic/links.tmp || true
      mv .mnemonic/links.tmp .mnemonic/links; render_agents; echo "unlinked $1" ;;
    list)
      [ -s .mnemonic/links ] || { echo "(no submonics; mn sub link <name> <repo>)"; return 0; }
      for n in $(sub_names); do
        sub_resolve "$n"; c="not synced"
        [ -f "$S_DIR/INDEX.md" ] && c="$(grep -c '^- ' "$S_DIR/INDEX.md" || true) topics"
        printf '%-12s %s (%s)\n' "$n" "$(link_spec "$n")" "$c"
      done ;;
    sync)
      for n in ${1:-$(sub_names)}; do sub_resolve "$n"; sub_sync; done
      echo "synced" ;;
    find)
      [ $# -gt 0 ] || die "usage: mn sub find <words>"
      pat=$(printf '%s' "$*" | sed 's/[][\.*^$/]/\\&/g; s/  */|/g'); hit=1
      for n in $(sub_names); do
        sub_resolve "$n"
        if ! sub_ready; then sub_sync
        elif [ "$S_SELF" = 0 ] && [ -n "$(find "$S_REPO/.git/mn-synced" -mmin +1440 2>/dev/null)" ]; then
          echo "info $n cache older than 1 day (mn sub sync)"; fi
        [ -f "$S_DIR/INDEX.md" ] || continue
        m=$(grep -iE "^- .*($pat)" "$S_DIR/INDEX.md" || true)
        [ -n "$m" ] && { printf '%s\n' "$m" | sed "s#^- #$n/#"; hit=0; }
      done
      [ $hit -eq 0 ] || { echo "(no match)"; exit 1; } ;;
    show)
      [ $# -eq 1 ] || die "usage: mn sub show <name>/<topic>"
      sub_resolve "${1%%/*}"; t=${1#*/}
      sub_ready || sub_sync
      [ -f "$S_DIR/$t.md" ] || die "no topic: $1"
      cat "$S_DIR/$t.md" ;;
    path)
      [ $# -eq 1 ] || die "usage: mn sub path <name>"
      sub_resolve "$1"; echo "$S_DIR" ;;
    add)
      [ $# -eq 4 ] || die 'usage: mn sub add <name> <topic> "<keywords>" "<summary>"'
      sub_resolve "$1"; sub_sync; ensure_submonic "$1"
      printf '%s' "$2" | grep -qE '^[A-Za-z0-9._-]+$' || die "topic must match [A-Za-z0-9._-]+"
      [ "$2" != INDEX ] && [ "$2" != README ] || die "reserved name: $2"
      grep -q "^- $2:" "$S_DIR/INDEX.md" && die "topic exists: $1/$2"
      printf -- '- %s: %s - %s\n' "$2" "$3" "$4" >> "$S_DIR/INDEX.md"
      [ -f "$S_DIR/$2.md" ] || printf '# %s\nkeywords: %s\nsummary: %s\nupdated: %s\n\n' "$2" "$3" "$4" "$(date +%Y-%m-%d)" > "$S_DIR/$2.md"
      sub_commit "Add $1/$2"
      echo "edit $S_DIR/$2.md, then: mn sub save $1 \"<message>\"" ;;
    save)
      [ $# -ge 1 ] || die 'usage: mn sub save <name> ["message"]'
      sub_resolve "$1"
      sub_ready || die "not synced: $1"
      sub_commit "${2:-Update $1}" ;;
    *) die "unknown sub command: $sub" ;;
  esac
}

# ---------- archive ----------

cmd_archive() {
  cd "$(root_dir)"
  [ $# -eq 1 ] || die "usage: mn archive <topic>"
  [ -f "memory/$1.md" ] || die "no topic: $1"
  mkdir -p memory/archive
  if git ls-files --error-unmatch "memory/$1.md" >/dev/null 2>&1; then git mv "memory/$1.md" "memory/archive/$1.md"
  else mv "memory/$1.md" "memory/archive/$1.md"; fi
  grep -v "^- $1:" memory/INDEX.md > memory/INDEX.md.tmp || true
  mv memory/INDEX.md.tmp memory/INDEX.md
  echo "archived memory/$1.md -> memory/archive/$1.md (out of the index, still in git)"
}

# ---------- hooks ----------

precommit_hook() {
  cat <<'HOOK'
#!/bin/sh
# mnemonic pre-commit: work commits must carry an updated STATE.md and pass mn check.
# Bypass once: MN_SKIP=1 git commit ...
[ "${MN_SKIP:-}" = 1 ] && exit 0
cd "$(git rev-parse --show-toplevel)" || exit 0
gd=$(git rev-parse --git-dir)
if [ -x "$gd/hooks/pre-commit" ]; then "$gd/hooks/pre-commit" || exit 1; fi
staged=$(git diff --cached --name-only)
[ -n "$staged" ] || exit 0
work=$(printf '%s\n' "$staged" | grep -vE '^(STATE\.md|memory/|shared/|\.mnemonic/|AGENTS\.md|CLAUDE\.md|\.claude/|\.gitignore$)' || true)
if [ -n "$work" ] && ! printf '%s\n' "$staged" | grep -qx 'STATE.md'; then
  echo "mnemonic: this commit changes work files but not STATE.md." >&2
  echo "Rewrite STATE.md (drop finished items, update Current/Next), git add STATE.md, commit again." >&2
  exit 1
fi
[ -f .mnemonic/mn ] || exit 0
out=$(sh .mnemonic/mn check --pre-commit 2>&1) || { printf '%s\n' "$out" | grep -v '^ok ' >&2; echo "mnemonic: fix the warnings above, then commit again." >&2; exit 1; }
exit 0
HOOK
}

agent_settings() {
  cat <<'JSON'
{
  "hooks": {
    "SessionStart": [{"hooks": [{"type": "command", "command": "sh .mnemonic/mn hook start"}]}],
    "Stop": [{"hooks": [{"type": "command", "command": "sh .mnemonic/mn hook stop"}]}]
  }
}
JSON
}

install_hooks() {
  mkdir -p .mnemonic/hooks
  precommit_hook > .mnemonic/hooks/pre-commit; chmod +x .mnemonic/hooks/pre-commit
  echo "wrote    .mnemonic/hooks/pre-commit"
  activate_git_hooks
}

activate_git_hooks() {
  git rev-parse --git-dir >/dev/null 2>&1 || return 0
  cur=$(git config core.hooksPath || true)
  if [ -z "$cur" ]; then git config core.hooksPath .mnemonic/hooks; echo "enabled  git hooks (core.hooksPath=.mnemonic/hooks)"
  elif [ "$cur" != .mnemonic/hooks ]; then echo "WARN core.hooksPath is $cur: add .mnemonic/hooks/pre-commit to it manually"; fi
}

install_agent_hooks() {
  # Agent adapter hooks (session start / turn end), merged into .claude/settings.json.
  mkdir -p .claude
  f=.claude/settings.json
  if [ ! -f "$f" ]; then agent_settings > "$f"; echo "created  $f (hooks)"; return; fi
  grep -q 'mn hook' "$f" && { echo "kept     $f (hooks present)"; return; }
  if command -v python3 >/dev/null 2>&1; then
    agent_settings | python3 -c '
import json, sys
f = sys.argv[1]; cur = json.load(open(f)); add = json.load(sys.stdin)
h = cur.setdefault("hooks", {})
for ev, entries in add["hooks"].items(): h.setdefault(ev, []).extend(entries)
json.dump(cur, open(f, "w"), indent=2); open(f, "a").write("\n")' "$f" && echo "updated  $f (hooks merged)"
  else
    echo "WARN $f exists and python3 is missing: merge the output of 'mn hook settings' manually"
  fi
}

cmd_hook() {
  cd "$(root_dir)"
  case "${1:-}" in
    start)
      # Session start: enable git hooks in fresh clones, refresh shared memory, report problems.
      [ -f .mnemonic/hooks/pre-commit ] && activate_git_hooks >/dev/null
      if [ -s .mnemonic/links ]; then (cmd_sub sync >/dev/null 2>&1) || echo "mnemonic: shared memory sync failed (check access)"; fi
      out=$( (cmd_check) 2>/dev/null) || printf '%s\n' "$out" | grep -E '^(WARN|FAIL)' | sed 's/^/mnemonic: /'
      exit 0 ;;
    stop)
      # Turn end: save shared memory edits; require a STATE.md update after unreflected commits.
      input=$(cat 2>/dev/null || true)
      for n in $(sub_names); do
        sub_resolve "$n"; [ "$S_SELF" = 0 ] && [ -d "$S_REPO/.git" ] || continue
        [ -n "$(git -C "$S_REPO" status --porcelain 2>/dev/null)" ] && { (push_repo "$S_REPO" "Update $n" >/dev/null 2>&1) || true; }
      done
      printf '%s' "$input" | grep -q '"stop_hook_active" *: *true' && exit 0
      last=$(git log -1 --format=%H -- STATE.md 2>/dev/null || true)
      [ -n "$last" ] || exit 0
      behind=$(git rev-list --count "$last..HEAD" 2>/dev/null || echo 0)
      if [ "$behind" -gt 0 ]; then
        printf '{"decision":"block","reason":"mnemonic: %s commit(s) since STATE.md was last updated. Rewrite STATE.md (caps, finished items removed, next steps), run .mnemonic/mn check, commit it, then finish."}\n' "$behind"
      fi
      exit 0 ;;
    settings) agent_settings ;;
    *) die "usage: mn hook start|stop|settings" ;;
  esac
}

# ---------- status ----------

cmd_status() {
  cd "$(root_dir)"
  load_config .
  echo "mnemonic $MN_VERSION in $(basename "$(pwd)")"
  printf 'preferences: chat %s, work %s, commits %s, brand refs %s, code %s, priority %s, docs %s, tone %s\n' \
    "$P_CHAT" "$P_WORK" "$P_COMMITS" "$P_BRAND" "$P_CODE" "$P_PRIORITY" "$P_DOCS" "$P_TONE"
  [ -f STATE.md ] && echo "state:       STATE.md ~$(( $(wc -c < STATE.md) / 4 ))/$MN_MAX_TOKENS tokens, loaded every session"
  [ -f memory/INDEX.md ] && echo "memory:      $(grep -c '^- ' memory/INDEX.md || true) topic(s), read on demand; $(ls memory/archive 2>/dev/null | wc -l | tr -d ' ') archived"
  if [ -s .mnemonic/links ]; then echo "shared:      $(sub_names | tr '\n' ' ')(on demand, all sessions write)"
  else echo "shared:      none (mn sub link <name> <repo>)"; fi
  h=off; [ "$(git config core.hooksPath 2>/dev/null)" = .mnemonic/hooks ] && h=on
  a=off; grep -q 'mn hook' .claude/settings.json 2>/dev/null && a=on
  echo "automation:  git pre-commit $h, agent session hooks $a"
  echo "commands:    .mnemonic/mn help    guide: .mnemonic/README.md"
}

# ---------- update ----------

cmd_update() {
  cd "$(root_dir)"
  mkdir -p .mnemonic
  tmp=$(mktemp)
  if command -v curl >/dev/null 2>&1; then curl -fsSL "$MN_URL/mn" -o "$tmp"
  elif command -v wget >/dev/null 2>&1; then wget -qO "$tmp" "$MN_URL/mn"
  else rm -f "$tmp"; die "curl or wget required"; fi
  head -1 "$tmp" | grep -q '^#!/bin/sh' || { rm -f "$tmp"; die "download is not an mn script"; }
  mv "$tmp" .mnemonic/mn && chmod +x .mnemonic/mn
  echo "updated .mnemonic/mn to $(sh .mnemonic/mn version)"
}

cmd=${1:-help}; [ $# -gt 0 ] && shift
case "$cmd" in
  init)    cmd_init "$@" ;;
  check)   cmd_check "$@" ;;
  archive) cmd_archive "$@" ;;
  hook)    cmd_hook "$@" ;;
  status)  cmd_status ;;
  mem)     cmd_mem "$@" ;;
  sub)     cmd_sub "$@" ;;
  update)  cmd_update ;;
  version) echo "$MN_VERSION" ;;
  help|-h|--help) usage ;;
  *) usage >&2; exit 2 ;;
esac
